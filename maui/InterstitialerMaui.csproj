<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0-maccatalyst</TargetFrameworks>
    <!-- On Windows, allow simple portable folder extraction and execution -->
    <WindowsPackageType Condition="$([MSBuild]::IsOSPlatform('windows'))">None</WindowsPackageType>
    <OutputType>WinExe</OutputType>
    <RootNamespace>InterstitialerMaui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display Name & App ID -->
    <ApplicationTitle>Interstitial-er</ApplicationTitle>
    <ApplicationId>com.interstitialer.scheduler.maui</ApplicationId>
    <ApplicationDisplayVersion>0.1.2</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('mac'))">13.1</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::IsOSPlatform('windows'))">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Avoid standard MAUI splash screen and boilerplate assets -->
    <MauiKeepSplashScreen>false</MauiKeepSplashScreen>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon configurations -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0f172a" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0-preview.*" Condition="'$(TargetFramework)' == ''" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0-preview.*" Condition="'$(TargetFramework)' == ''" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link and copy the compiled frontend web asset folder into the MAUI output bundle -->
    <Content Include="..\dist\**\*">
      <Link>dist\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
